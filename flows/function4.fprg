    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="discountPercent, price" type="Real" array="False" size=""/>
            <input variable="price"/>
            <input variable="discountPercent"/>
            <call expression="total(price,discountPercent)"/>
            <input variable="price"/>
            <input variable="discountPercent"/>
            <call expression="total(price,discountPercent)"/>
        </body>
    </function>
    <function name="Total" type="None" variable="">
        <parameters>
            <parameter name="price" type="Real" array="False"/>
            <parameter name="discount" type="Real" array="False"/>
        </parameters>
        <body>
            <declare name="total" type="Real" array="False" size=""/>
            <if expression="discount == 0">
                <then>
                    <assign variable="discount" expression="5"/>
                    <assign variable="total" expression="price-(price*0.01*discount)"/>
                    <output expression="&quot;=== COFFEE PRICE CALCULATOR ===&quot;&#13;&#10;&amp;&#13;&#10;ToChar(13)&#13;&#10;&amp;&#13;&#10;&quot;Calling Total (&quot;&amp;price&amp;&quot;)&quot;&#13;&#10;&amp;&#13;&#10;toChar(13)&#13;&#10;&amp;&#13;&#10;&quot;-&gt; default discount 5% applied&quot;&#13;&#10;&amp;&#13;&#10;toChar(13)&#13;&#10;&amp;&#13;&#10;&quot;Total Price : &quot;&amp;total" newline="True"/>
                </then>
                <else>
                    <assign variable="total" expression="price-(price*0.01*discount)"/>
                    <output expression="&quot;=== COFFEE PRICE CALCULATOR ===&quot;&#13;&#10;&amp;&#13;&#10;ToChar(13)&#13;&#10;&amp;&#13;&#10;&quot;Calling Total (&quot;&amp;price&amp;&quot;)&quot;&#13;&#10;&amp;&#13;&#10;toChar(13)&#13;&#10;&amp;&#13;&#10;&quot;Total Price : &quot;&amp;total" newline="True"/>
                </else>
            </if>
        </body>
    </function>
</flowgorithm>
