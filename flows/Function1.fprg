    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="name" type="String" array="False" size=""/>
            <output expression="&quot;=== WELCOME MESSAGE ===&quot;" newline="True"/>
            <assign variable="name" expression="&quot;Kenzo Aditya&quot;"/>
            <call expression="PrintWelcome(name)"/>
