    <function name="PrintWelcome" type="None" variable="">
        <parameters>
            <parameter name="name" type="String" array="False"/>
        </parameters>
        <body>
            <output expression="&quot;Welcome to Moklet Coding Club &quot;&amp;name&amp;&quot;!&quot;" newline="True"/>
        </body>
    </function>
