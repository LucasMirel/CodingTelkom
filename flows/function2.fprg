    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="inputNum" type="Real" array="False" size=""/>
            <output expression="&quot;=== SQUARE CALCULATOR ===&quot;" newline="True"/>
            <output expression="&quot;Input Number = &quot;" newline="True"/>
            <input variable="inputNum"/>
            <call expression="Square(inputNum)"/>
        </body>
    </function>
    <function name="Square" type="None" variable="">
        <parameters>
            <parameter name="number" type="Real" array="False"/>
        </parameters>
        <body>
            <declare name="squaredNum" type="Real" array="False" size=""/>
            <assign variable="squaredNum" expression="number*number"/>
            <output expression="&quot;Calling Square (&quot;&amp;number&amp;&quot;)&quot;" newline="True"/>
            <output expression="number &amp; &quot; Squared is &quot;&amp;squaredNum" newline="True"/>
        </body>
    </function>
</flowgorithm>
