        <attribute name="edited" value="TVVIQU1NQUQgQVlESU47TEFQVE9QLUZPTlJKSlBUOzIwMjYtMTAtMTY7MTA6MTU6MTcgUE07MjszNTA3"/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="quantity" type="Integer" array="False" size=""/>
            <declare name="subTotal, shippingCost, grandTotal, price" type="Real" array="False" size=""/>
            <output expression="&quot;Input price and quantity&quot;" newline="True"/>
            <input variable="price"/>
            <input variable="quantity"/>
            <assign variable="subTotal" expression="CalculateSubtotal (quantity, price)"/>
            <assign variable="shippingCost" expression="CalculateShipping(subTotal)"/>
            <assign variable="grandTotal" expression="subTotal+shippingCost"/>
            <output expression="&quot;====  ONLINE STORE INVOICE ====&quot;&#13;&#10;&amp;toChar(13)&amp;&#13;&#10;&quot;Calling CalculateSubtotal (&quot;&amp;price&amp;&quot;, &quot;&amp;quantity&amp;&quot;)&quot;&#13;&#10;&amp;toChar(13)&amp;&#13;&#10;&quot;Subtotal : Rp&quot;&amp;subTotal&#13;&#10;&amp;toChar(13)&amp;toChar(13)&amp;&#13;&#10;&quot;Calling CalculateShipping (&quot;&amp;subTotal&amp;&quot;)&quot;&#13;&#10;&amp;toChar(13)&amp;&#13;&#10;&quot;Shipping Cost : Rp&quot;&amp;shippingCost&amp;&quot; (FREE - subtotal &gt;= Rp200,000)&quot;&#13;&#10;&amp;toChar(13)&amp;toChar(13)&amp;&#13;&#10;&quot;Grand Total : &quot;&amp;grandTotal" newline="True"/>
        </body>
    </function>
    <function name="CalculateShipping" type="Real" variable="ship">
        <parameters>
            <parameter name="subTotal" type="Real" array="False"/>
        </parameters>
        <body>
            <declare name="ship" type="Real" array="False" size=""/>
            <if expression="subTotal &gt;=200000">
                <then>
                    <assign variable="ship" expression="0"/>
                </then>
                <else>
                    <assign variable="ship" expression="15000"/>
                </else>
            </if>
        </body>
    </function>
    <function name="CalculateSubtotal" type="Real" variable="subTotal">
        <parameters>
            <parameter name="price" type="Real" array="False"/>
            <parameter name="quantity" type="Integer" array="False"/>
        </parameters>
        <body>
            <declare name="subTotal" type="Real" array="False" size=""/>
            <assign variable="subTotal" expression="price*quantity"/>
        </body>
    </function>
</flowgorithm>
